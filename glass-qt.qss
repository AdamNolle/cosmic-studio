/* Studio Light chrome only; content widgets retain the COSMIC palette. */
QMenuBar, QToolBar {
  background: #e9e7e1;
  color: #1f1f22;
  border-bottom: 1px solid #b9b7b2;
}
QMenu {
  background: #eeece7;
  color: #1f1f22;
  border: 1px solid #b9b7b2;
  padding: 5px;
}
QMenu::item { padding: 5px 24px 5px 8px; border-radius: 3px; }
QMenu::item:selected { background: #1d5ab0; color: #ffffff; }
QMenu::separator { height: 1px; background: #d9d7d1; margin: 4px 6px; }

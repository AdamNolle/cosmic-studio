+            let (inset, radius) = glass_geometry(w, h, true);
+            assert!(inset >= 0.0 && radius >= 0.0);
+            assert!(w - inset * 2.0 >= 1.0 && h - inset * 2.0 >= 1.0);
+            assert!(radius * 2.0 <= (w - inset * 2.0).min(h - inset * 2.0));

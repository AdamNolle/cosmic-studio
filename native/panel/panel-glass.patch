+        fn client_compositor_state<'a>(&self, client: &'a Client) -> &'a CompositorClientState {
+            &client.get_data::<TestClientData>().unwrap().compositor
+        }
+
+        fn new_surface(&mut self, surface: &WlSurface) {
+            self.surfaces.push(surface.clone());
+        }
+
+        fn commit(&mut self, _surface: &WlSurface) {}
+    }
+
+    impl BlurHandler for TestState {
+        fn commit_blur(
+            &mut self,
+            region: Option<Vec<Rectangle<i32, Logical>>>,
+            surface: &WlSurface,
+        ) {
+            if self.forwarding_ready {
+                self.forwarded.push((surface.clone(), region));
+            }
+        }
+    }
+
+    smithay::delegate_dispatch2!(TestState);
+
+    #[derive(Default)]
+    struct TestClient {
+        compositor: Option<wl_compositor::WlCompositor>,
+    }
+
+    impl Dispatch<wl_registry::WlRegistry, ()> for TestClient {
+        fn event(
+            state: &mut Self,
+            registry: &wl_registry::WlRegistry,
+            event: wl_registry::Event,
+            _data: &(),
+            _connection: &Connection,
+            qh: &QueueHandle<Self>,
+        ) {
+            if let wl_registry::Event::Global { name, interface, version } = event {
+                if interface == "wl_compositor" {
+                    state.compositor = Some(registry.bind(name, version.min(6), qh, ()));
+                }
+            }
+        }
+    }
+
+    impl Dispatch<wl_compositor::WlCompositor, ()> for TestClient {
+        fn event(
+            _state: &mut Self,
+            _proxy: &wl_compositor::WlCompositor,
+            _event: wl_compositor::Event,
+            _data: &(),
+            _connection: &Connection,
+            _qh: &QueueHandle<Self>,
+        ) {
+        }
+    }
+
+    impl Dispatch<wl_surface::WlSurface, ()> for TestClient {
+        fn event(
+            _state: &mut Self,
+            _proxy: &wl_surface::WlSurface,
+            _event: wl_surface::Event,
+            _data: &(),
+            _connection: &Connection,
+            _qh: &QueueHandle<Self>,
+        ) {
+        }
+    }
+
+    /// A private socket pair exercises Smithay's real pending/current commit
+    /// ordering without a display server, GPU, session bus, or live desktop.
+    struct Fixture {
+        display: Display<TestState>,
+        state: TestState,
+        connection: Connection,
+        _queue: EventQueue<TestClient>,
+        client_surfaces: Vec<wl_surface::WlSurface>,
+    }
+
+    impl Fixture {
+        fn new(surface_count: usize) -> Self {
+            let mut display = Display::<TestState>::new().unwrap();
+            let mut dh = display.handle();
+            let mut state = TestState {
+                compositor: CompositorState::new::<TestState>(&dh),
+                surfaces: Vec::new(),
+                forwarded: Vec::new(),
+                forwarding_ready: true,
+            };
+            let (server_socket, client_socket) = UnixStream::pair().unwrap();
+            dh.insert_client(server_socket, Arc::new(TestClientData::default())).unwrap();
+            let connection = Connection::from_socket(client_socket).unwrap();
+            let mut queue = connection.new_event_queue::<TestClient>();
+            let qh = queue.handle();
+            let mut client = TestClient::default();
+            let _registry = connection.display().get_registry(&qh, ());
+            connection.flush().unwrap();
+            display.dispatch_clients(&mut state).unwrap();
+            display.flush_clients().unwrap();
+            queue.blocking_dispatch(&mut client).unwrap();
+            let compositor = client.compositor.unwrap();
+            let client_surfaces =
+                (0..surface_count).map(|_| compositor.create_surface(&qh, ())).collect();
+            connection.flush().unwrap();
+            display.dispatch_clients(&mut state).unwrap();
+            assert_eq!(state.surfaces.len(), surface_count);
+            Self { display, state, connection, _queue: queue, client_surfaces }
+        }
+
+        fn commit(&mut self, index: usize) {
+            self.client_surfaces[index].commit();
+            self.connection.flush().unwrap();
+            self.display.dispatch_clients(&mut self.state).unwrap();
+        }
+
+        fn set_pending(&mut self, index: usize, region: Option<Vec<Rectangle<i32, Logical>>>) {
+            with_states(&self.state.surfaces[index], |states| {
+                states.cached_state.get::<ComputedBlurRegionCachedState>().pending().blur_region =
+                    region;
+            });
+        }
+    }
+
+    #[test]
+    fn first_changed_blur_request_is_forwarded_and_unchanged_commits_are_quiet() {
+        let mut fixture = Fixture::new(1);
+        let surface = fixture.state.surfaces[0].clone();
+        hook_commit::<TestState>(&surface);
+        let first = Some(vec![Rectangle::new((3, 4).into(), (120, 80).into())]);
+        fixture.set_pending(0, first.clone());
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded, vec![(surface.clone(), first)]);
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded.len(), 1);
+
+        let resized = Some(vec![Rectangle::new((3, 4).into(), (160, 80).into())]);
+        fixture.set_pending(0, resized.clone());
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded[1], (surface.clone(), resized));
+        fixture.set_pending(0, None);
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded[2], (surface, None));
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded.len(), 3);
+    }
+
+    #[test]
+    fn layer_requests_select_only_their_matching_proxy() {
+        let fixture = Fixture::new(3);
+        let mut proxies: Vec<_> =
+            fixture.state.surfaces[..2].iter().cloned().map(|surface| (surface, false)).collect();
+        let requested = &fixture.state.surfaces[1];
+        let matching = proxy_for_surface(&mut proxies, requested, |proxy| &proxy.0).unwrap();
+        matching.1 = true;
+        assert!(!proxies[0].1, "unrelated first layer must not receive this request");
+        assert!(proxies[1].1, "requested layer must receive its request");
+        assert!(
+            proxy_for_surface(&mut proxies, &fixture.state.surfaces[2], |proxy| &proxy.0).is_none()
+        );
+    }
+
+    #[test]
+    fn initial_layer_blur_is_replayed_once_after_its_proxy_exists() {
+        let mut fixture = Fixture::new(1);
+        let surface = fixture.state.surfaces[0].clone();
+        hook_commit::<TestState>(&surface);
+        fixture.state.forwarding_ready = false;
+        let requested = Some(vec![Rectangle::from_size((120, 80).into())]);
+        fixture.set_pending(0, requested.clone());
+        fixture.commit(0);
+        assert!(fixture.state.forwarded.is_empty());
+
+        fixture.state.forwarding_ready = true;
+        replay_current_blur(&mut fixture.state, &surface);
+        assert_eq!(fixture.state.forwarded, vec![(surface, requested)]);
+        fixture.commit(0);
+        assert_eq!(fixture.state.forwarded.len(), 1);
+    }
+}

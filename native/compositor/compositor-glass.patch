+                    && face.weight.0 == weight
+                    && (face.style == fontdb::Style::Italic) == italic
+                    && matches!(face.source, fontdb::Source::Binary(_))
+            }), "Missing native custom-renderer face: {family} {weight} italic={italic}");
+        }

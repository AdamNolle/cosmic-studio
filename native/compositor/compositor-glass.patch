+++ b/src/shell/element/chrome_policy.rs
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Event-driven, bounded server-decoration policy for clients without theme hints.
+//! XDG toplevel/decoration does not expose a light/dark preference in this SDK.
+//! Exact Spotify IDs therefore use one cached native dark palette. Client-owned
+//! decorations and all other applications retain their own/system theme.
+
+use cosmic::cosmic_theme::{ThemeBuilder, palette::Srgba};
+use cosmic::{Theme, theme::ThemeType};
+use std::sync::{Arc, LazyLock};
+
+static SPOTIFY_CHROME: LazyLock<Arc<cosmic::cosmic_theme::Theme>> = LazyLock::new(|| {
+    let mut theme = ThemeBuilder::dark()
+        .bg_color(Srgba::new(18.0 / 255.0, 18.0 / 255.0, 18.0 / 255.0, 1.0))
+        .primary_container_bg(Srgba::new(24.0 / 255.0, 24.0 / 255.0, 24.0 / 255.0, 1.0))
+        .build();
+    // A black client should keep a solid matching frame even over bright content.
+    theme.frosted_windows = false;
+    // Match the reviewed system radii. Native SSD maps radius_s4 to outer8.
+    // Maximized/tiled geometry still follows the existing compositor policy.
+    theme.corner_radii = cosmic::cosmic_theme::CornerRadii {
+        radius_0: [0.0; 4],
+        radius_xs: [2.0; 4],
+        radius_s: [4.0; 4],
+        radius_m: [6.0; 4],
+        radius_l: [8.0; 4],
+        radius_xl: [10.0; 4],
+    };
+    Arc::new(theme)
+});
+
+fn prefers_black_chrome(app_id: &str) -> bool {
+    app_id.eq_ignore_ascii_case("spotify") || app_id.eq_ignore_ascii_case("com.spotify.Client")
+}
+
+pub(super) fn for_app(base: &Theme, app_id: &str) -> Theme {
+    if !prefers_black_chrome(app_id) || base.cosmic().is_high_contrast {
+        return base.clone();
+    }
+    let mut selected = base.clone();
+    selected.theme_type = ThemeType::Custom(SPOTIFY_CHROME.clone());
+    selected.transparent = false;
+    selected
+}
+
+pub(super) fn is_black_chrome(theme: &Theme) -> bool {
+    matches!(&theme.theme_type, ThemeType::Custom(palette) if Arc::ptr_eq(palette, &SPOTIFY_CHROME))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn exact_identity_only() {
+        assert!(prefers_black_chrome("spotify"));
+        assert!(prefers_black_chrome("Spotify"));
+        assert!(prefers_black_chrome("com.spotify.Client"));
+        for other in [
+            "",
+            "spotify-preview",
+            "myspotify",
+            "com.spotify.Client.test",
+            "com.system76.CosmicFiles",
+        ] {
+            assert!(!prefers_black_chrome(other));
+        }
+    }
+
+    #[test]
+    fn light_apps_keep_their_original_palette() {
+        let light = Theme::light();
+        let selected = for_app(&light, "com.system76.CosmicFiles");
+        assert_eq!(selected, light);
+        assert!(!is_black_chrome(&selected));
+    }
+
+    #[test]
+    fn spotify_uses_one_opaque_native_dark_palette() {
+        let first = for_app(&Theme::light(), "spotify");
+        let second = for_app(&Theme::dark(), "com.spotify.Client");
+        assert!(is_black_chrome(&first) && is_black_chrome(&second));
+        assert!(first.cosmic().is_dark);
+        assert!(!first.transparent && !first.cosmic().frosted_windows);
+        let background = first.cosmic().background(false).base;
+        for channel in [background.red, background.green, background.blue] {
+            assert!((channel - 18.0 / 255.0).abs() < 0.0001);
+        }
+        assert_eq!(background.alpha, 1.0);
+    }
+
+    #[test]
+    fn dark_chrome_matches_subtle_system_corners() {
+        let theme = for_app(&Theme::light(), "spotify");
+        let radii = &theme.cosmic().corner_radii;
+        assert_eq!(radii.radius_0, [0.0; 4]);
+        assert_eq!(radii.radius_xs, [2.0; 4]);
+        assert_eq!(radii.radius_s, [4.0; 4]);
+        assert_eq!(radii.radius_m, [6.0; 4]);
+        assert_eq!(radii.radius_l, [8.0; 4]);
+        assert_eq!(radii.radius_xl, [10.0; 4]);
+    }
+
+    #[test]
+    fn high_contrast_preference_remains_authoritative() {
+        let accessible = Theme::light_hc();
+        assert_eq!(for_app(&accessible, "spotify"), accessible);
+    }

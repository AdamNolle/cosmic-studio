+        strength as f64 * source.w / destination.w.max(1) as f64 / buffer.w.max(1) as f64,
+        strength as f64 * source.h / destination.h.max(1) as f64 / buffer.h.max(1) as f64,
+    ));
+    let step = transform.invert().transform_size(step);
+    (step.w as f32, step.h as f32)

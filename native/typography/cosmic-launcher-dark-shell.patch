+// Native shell material; no environment or child-application overrides.
+fn studio_dark_theme() -> cosmic::theme::Theme {
+    let dark = cosmic::theme::system_dark().cosmic().clone();
+    cosmic::theme::Theme::custom(std::sync::Arc::new(dark))
+}
+
+fn studio_dark_shell() -> Task<Message> {
+    Task::done(cosmic::action::cosmic(cosmic::app::Action::AppThemeChange(
+        studio_dark_theme(),
+    )))
+}

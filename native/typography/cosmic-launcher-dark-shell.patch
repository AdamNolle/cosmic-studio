+#[cfg(test)]
+mod studio_tests {
+    use super::*;
+
+    #[test]
+    fn shell_theme_is_dark_and_process_local() {
+        let before = cosmic::theme::active_type();
+        let dark = studio_dark_theme();
+        assert!(dark.cosmic().is_dark);
+        assert!(matches!(dark.theme_type, cosmic::theme::ThemeType::Custom(_)));
+        assert_eq!(before, cosmic::theme::active_type());
+    }
+
+    #[test]
+    fn launcher_rows_preserve_balanced_native_padding() {
+        let padding = menu_control_padding();
+        assert_eq!(padding.top, 8.0);
+        assert_eq!(padding.bottom, 8.0);
+        assert_eq!(padding.left, 24.0);
+        assert_eq!(padding.right, 24.0);
+    }

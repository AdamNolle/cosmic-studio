+    #[test]
+    fn desktop_names_have_no_idle_box_and_retain_selection() {
+        use cosmic::iced::Color;
+        for theme in [cosmic::Theme::light(), cosmic::Theme::dark()] {
+            let idle = super::button_appearance(&theme, false, false, false, false, true, true, true);
+            assert!(idle.background.is_none(), "desktop labels must reveal the wallpaper");
+            assert_eq!(idle.text_color, Some(Color::WHITE));
+            let cut = super::button_appearance(&theme, false, false, true, false, true, true, true);
+            assert!(cut.background.is_none());
+            assert!(cut.text_color.unwrap().a < 1.0);
+            let selected = super::button_appearance(&theme, true, false, false, true, true, true, true);
+            assert!(selected.background.is_some(), "selection must remain visible");
+            assert!(selected.outline_width > 0.0, "keyboard focus must remain visible");
+            let file = super::button_appearance(&theme, false, false, false, false, true, true, false);
+            assert!(file.text_color.is_none(), "ordinary file views retain their theme");
+        }
+    }

diff --git a/winit/src/platform_specific/wayland/handlers/blur_lifecycle.rs b/winit/src/platform_specific/wayland/handlers/blur_lifecycle.rs
new file mode 100644
index 0000000..9b0e91e
--- /dev/null
+++ b/winit/src/platform_specific/wayland/handlers/blur_lifecycle.rs
@@ -0,0 +1,248 @@
+//! Popup-only background-effect lifecycle, independent of protocol objects.
+//! Desired state survives creation/capability ordering; applied state prevents
+//! duplicate objects and redundant requests. Coordinates stay surface-local.
+
+use std::collections::HashMap;
+use std::hash::Hash;
+
+// The installed COSMIC compositor uses the corrected v1 Blur bit. The pinned
+// client enum decodes it as Unknown(1); zero means no advertised capability.
+pub(crate) fn supports_blur(bits: u32) -> bool {
+    bits & 1 != 0
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct RegionRect {
+    pub x: i32,
+    pub y: i32,
+    pub width: i32,
+    pub height: i32,
+}
+
+pub(crate) fn rectangle(
+    x: f32,
+    y: f32,
+    width: f32,
+    height: f32,
+) -> Option<RegionRect> {
+    if !x.is_finite()
+        || !y.is_finite()
+        || width.is_nan()
+        || height.is_nan()
+        || width <= 0.0
+        || height <= 0.0
+    {
+        return None;
+    }
+    // The native toolkit uses positive-infinite extents as a full-surface
+    // sentinel. Bound them safely; the compositor clips to actual surface size.
+    // Do not convert surface-local logical coordinates to buffer pixels.
+    const LIMIT: f64 = 1_048_576.0;
+    let left = f64::from(x).floor().clamp(-LIMIT, LIMIT) as i32;
+    let top = f64::from(y).floor().clamp(-LIMIT, LIMIT) as i32;
+    let right = (f64::from(x) + f64::from(width))
+        .ceil()
+        .clamp(-LIMIT, LIMIT) as i32;
+    let bottom = (f64::from(y) + f64::from(height))
+        .ceil()
+        .clamp(-LIMIT, LIMIT) as i32;
+    (right > left && bottom > top).then_some(RegionRect {
+        x: left,
+        y: top,
+        width: right - left,
+        height: bottom - top,
+    })
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Change {
+    Quiet,
+    Create(Vec<RegionRect>),
+    Update(Vec<RegionRect>),
+    Remove,
+}
+
+pub(crate) struct BlurLifecycle<I> {
+    desired: HashMap<I, Vec<RegionRect>>,
+    applied: HashMap<I, Vec<RegionRect>>,
+}
+
+impl<I: Copy + Eq + Hash> Default for BlurLifecycle<I> {
+    fn default() -> Self {
+        Self {
+            desired: HashMap::new(),
+            applied: HashMap::new(),
+        }
+    }
+}
+
+impl<I: Copy + Eq + Hash> BlurLifecycle<I> {
+    pub fn request(&mut self, id: I, region: Option<Vec<RegionRect>>) {
+        match region {
+            Some(region) => {
+                _ = self.desired.insert(id, region);
+            }
+            None => {
+                _ = self.desired.remove(&id);
+            }
+        }
+    }
+
+    pub fn reconcile(
+        &mut self,
+        id: I,
+        available: bool,
+        exists: bool,
+    ) -> Change {
+        if !exists {
+            return Change::Quiet;
+        }
+        if !available || !self.desired.contains_key(&id) {
+            return if self.applied.remove(&id).is_some() {
+                Change::Remove
+            } else {
+                Change::Quiet
+            };
+        }
+        let desired = &self.desired[&id];
+        if self.applied.get(&id) == Some(desired) {
+            return Change::Quiet;
+        }
+        let prior = self.applied.insert(id, desired.clone());
+        if prior.is_some() {
+            Change::Update(desired.clone())
+        } else {
+            Change::Create(desired.clone())
+        }
+    }
+
+    pub fn remove(&mut self, id: I) {
+        _ = self.desired.remove(&id);
+        _ = self.applied.remove(&id);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn region(width: f32) -> Vec<RegionRect> {
+        vec![rectangle(0.0, 0.0, width, 60.0).unwrap()]
+    }
+
+    #[test]
+    fn zero_or_unknown_non_blur_capabilities_keep_material_opaque() {
+        assert!(!supports_blur(0));
+        assert!(!supports_blur(2));
+        assert!(supports_blur(1));
+        assert!(supports_blur(3));
+    }
+
+    #[test]
+    fn first_request_survives_both_creation_capability_orders() {
+        for capability_first in [true, false] {
+            let mut state = BlurLifecycle::default();
+            state.request(1, Some(region(80.0)));
+            assert_eq!(
+                state.reconcile(1, capability_first, !capability_first),
+                Change::Quiet
+            );
+            assert_eq!(
+                state.reconcile(1, true, true),
+                Change::Create(region(80.0))
+            );
+            assert_eq!(state.reconcile(1, true, true), Change::Quiet);
+        }
+    }
+
+    #[test]
+    fn resize_updates_existing_object_and_only_correct_popup() {
+        let mut state = BlurLifecycle::default();
+        state.request(1, Some(region(80.0)));
+        state.request(2, Some(region(90.0)));
+        assert_eq!(
+            state.reconcile(1, true, true),
+            Change::Create(region(80.0))
+        );
+        assert_eq!(
+            state.reconcile(2, true, true),
+            Change::Create(region(90.0))
+        );
+        state.request(1, Some(region(100.0)));
+        assert_eq!(
+            state.reconcile(1, true, true),
+            Change::Update(region(100.0))
+        );
+        assert_eq!(state.reconcile(2, true, true), Change::Quiet);
+    }
+
+    #[test]
+    fn unsupported_is_quiet_and_capability_loss_preserves_desired_request() {
+        let mut state = BlurLifecycle::default();
+        state.request(1, Some(region(80.0)));
+        assert_eq!(state.reconcile(1, false, true), Change::Quiet);
+        assert_eq!(
+            state.reconcile(1, true, true),
+            Change::Create(region(80.0))
+        );
+        assert_eq!(state.reconcile(1, false, true), Change::Remove);
+        assert_eq!(state.reconcile(1, false, true), Change::Quiet);
+        assert_eq!(
+            state.reconcile(1, true, true),
+            Change::Create(region(80.0))
+        );
+    }
+
+    #[test]
+    fn unset_and_native_destroy_prevent_stale_replay() {
+        let mut state = BlurLifecycle::default();
+        state.request(1, Some(region(80.0)));
+        state.request(1, None);
+        assert_eq!(state.reconcile(1, true, true), Change::Quiet);
+        state.request(1, Some(region(80.0)));
+        _ = state.reconcile(1, true, true);
+        state.request(1, None);
+        assert_eq!(state.reconcile(1, true, true), Change::Remove);
+        state.request(1, Some(region(80.0)));
+        state.remove(1);
+        assert_eq!(state.reconcile(1, true, true), Change::Quiet);
+    }
+
+    #[test]
+    fn regions_cover_fractional_logical_bounds_without_nan_or_overflow() {
+        assert_eq!(
+            rectangle(1.25, -0.25, 2.5, 4.5),
+            Some(RegionRect {
+                x: 1,
+                y: -1,
+                width: 3,
+                height: 6
+            })
+        );
+        assert_eq!(rectangle(f32::NAN, 0.0, 2.0, 2.0), None);
+        assert_eq!(rectangle(0.0, 0.0, -1.0, 2.0), None);
+        assert_eq!(rectangle(f32::INFINITY, 0.0, 2.0, 2.0), None);
+        assert_eq!(
+            rectangle(0.0, 0.0, f32::MAX, f32::MAX).unwrap().width,
+            1_048_576
+        );
+    }
+
+    #[test]
+    fn managed_popup_infinite_mask_requests_the_full_native_surface() {
+        let full = rectangle(0.0, 0.0, f32::INFINITY, f32::INFINITY).unwrap();
+        assert_eq!(
+            full,
+            RegionRect {
+                x: 0,
+                y: 0,
+                width: 1_048_576,
+                height: 1_048_576
+            }
+        );
+        let mut state = BlurLifecycle::default();
+        state.request(1, Some(vec![full]));
+        assert_eq!(state.reconcile(1, true, true), Change::Create(vec![full]));
+        assert_eq!(rectangle(0.0, 0.0, f32::NEG_INFINITY, 2.0), None);
+    }
+}

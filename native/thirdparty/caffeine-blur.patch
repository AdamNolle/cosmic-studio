@@ -0,0 +1,102 @@
+//! Narrow ext-background-effect v1 backport for managed XDG popup roots.
+
+use crate::platform_specific::wayland::{
+    event_loop::state::SctkState, sctk_event::SctkEvent,
+};
+use cctk::sctk::{
+    globals::GlobalData,
+    reexports::client::{
+        delegate_dispatch,
+        globals::{BindError, GlobalList},
+        protocol::wl_surface::WlSurface,
+        Connection, Dispatch, Proxy, QueueHandle,
+    },
+};
+use std::sync::atomic::{AtomicBool, Ordering};
+use wayland_protocols::ext::background_effect::v1::client::{
+    ext_background_effect_manager_v1::{Event, ExtBackgroundEffectManagerV1},
+    ext_background_effect_surface_v1::ExtBackgroundEffectSurfaceV1,
+};
+
+static AVAILABLE: AtomicBool = AtomicBool::new(false);
+pub fn available() -> bool {
+    AVAILABLE.load(Ordering::Acquire)
+}
+
+pub(crate) struct ExtBackgroundEffectManager {
+    manager: ExtBackgroundEffectManagerV1,
+    pub supported: bool,
+}
+
+impl ExtBackgroundEffectManager {
+    pub fn new(
+        globals: &GlobalList,
+        qh: &QueueHandle<SctkState>,
+    ) -> Result<Self, BindError> {
+        AVAILABLE.store(false, Ordering::Release);
+        Ok(Self {
+            manager: globals.bind(qh, 1..=1, GlobalData)?,
+            supported: false,
+        })
+    }
+
+    pub fn effect(
+        &self,
+        surface: &WlSurface,
+        qh: &QueueHandle<SctkState>,
+    ) -> ExtBackgroundEffectSurfaceV1 {
+        self.manager.get_background_effect(surface, qh, ())
+    }
+}
+
+impl Dispatch<ExtBackgroundEffectManagerV1, GlobalData, SctkState>
+    for ExtBackgroundEffectManager
+{
+    fn event(
+        state: &mut SctkState,
+        _: &ExtBackgroundEffectManagerV1,
+        event: Event,
+        _: &GlobalData,
+        _: &Connection,
+        _: &QueueHandle<SctkState>,
+    ) {
+        if let Event::Capabilities { flags } = event {
+            let bits = match flags {
+                wayland_client::WEnum::Value(value) => value.bits(),
+                wayland_client::WEnum::Unknown(value) => value,
+            };
+            let supported = super::blur_lifecycle::supports_blur(bits);
+            if let Some(manager) = state.ext_background_effect_manager.as_mut()
+            {
+                let changed = manager.supported != supported;
+                manager.supported = supported;
+                AVAILABLE.store(supported, Ordering::Release);
+                let ids: Vec<_> =
+                    state.popups.iter().map(|popup| popup.data.id).collect();
+                for id in ids {
+                    state.reconcile_popup_blur(id);
+                }
+                if changed {
+                    state.sctk_events.push(SctkEvent::BlurCapabilitiesChanged);
+                }
+            }
+        }
+    }
+}
+
+impl Dispatch<ExtBackgroundEffectSurfaceV1, (), SctkState>
+    for ExtBackgroundEffectManager
+{
+    fn event(
+        _: &mut SctkState,
+        _: &ExtBackgroundEffectSurfaceV1,
+        _: <ExtBackgroundEffectSurfaceV1 as Proxy>::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<SctkState>,
+    ) {
+    }
+}
+
+delegate_dispatch!(SctkState: [ExtBackgroundEffectManagerV1: GlobalData] => ExtBackgroundEffectManager);
+delegate_dispatch!(SctkState: [ExtBackgroundEffectSurfaceV1: ()] => ExtBackgroundEffectManager);

+//! Request native background blur for an XDG popup's surface-local region.
+
+use iced_runtime::{
+    core::{window, Rectangle},
+    platform_specific::{self, wayland},
+    task, Action, Task,
+};
+
+/// Whether this connection's compositor has advertised native blur support.
+/// Material must remain opaque until this becomes true.
+pub fn available() -> bool {
+    crate::platform_specific::wayland::handlers::ext_background_effect::available()
+}
+
+/// Record the desired region even when popup creation/capabilities are pending.
+/// `None` disables the effect; requests for non-popup IDs never affect windows.
+pub fn blur(id: window::Id, region: Option<Vec<Rectangle>>) -> Task<()> {
+    task::effect(Action::PlatformSpecific(
+        platform_specific::Action::Wayland(wayland::Action::BlurSurface(
+            id, region,
+        )),
+    ))
+}
